# Copy this file to .env on the server before running the app.
# Keep .env out of Git; local dev machine should not contain model/runtime secrets.

# Server-side Ollama endpoint
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=./.local_cache/ollama
MODEL_NAME=qwen2.5-coder:7b

# Local cache directories (relative to repo root)
HF_HOME=./.local_cache/huggingface
HF_DATASETS_CACHE=./.local_cache/huggingface/datasets
TRANSFORMERS_CACHE=./.local_cache/huggingface/transformers
CHROMA_DB_PATH=./.local_cache/chromadb

# Python path for editable local package usage
PYTHONPATH=./agilecoder
